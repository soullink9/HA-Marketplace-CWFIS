{
  "config": {
    "step": {
      "user": {
        "title": "Canadian Wildland Fire Information System",
        "description": "Adds CWFIS wildfire data using your Home location. Use Configure afterwards to change the settings."
      }
    },
    "abort": {
      "single_instance_allowed": "CWFIS is already set up. Use Configure on the existing entry to change its settings."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "CWFIS settings",
        "data": {
          "radius": "Alert radius",
          "zones": "Extra watch zones (optional)",
          "danger_distance": "Fire threat: danger distance",
          "warning_distance": "Fire threat: warning distance",
          "smoke_radius": "Smoke radius",
          "air_quality_scale": "Air quality scale",
          "wind_entity": "Wind direction sensor (optional)",
          "pm25_entity": "PM2.5 sensor (optional)",
          "pm25_threshold": "PM2.5 smoke threshold",
          "provinces": "Province sensors (optional)",
          "map_fires": "Fires on map",
          "map_images": "Map images (optional)"
        },
        "data_description": {
          "radius": "Agency-reported fires within this distance of a zone count as nearby and raise Fire alert events. Hotspots, perimeters and prescribed burns are also counted within this distance.",
          "zones": "Home is always watched. Add zones (cottage, family, trip) to get the same sensors for each.",
          "danger_distance": "Fire threat is Danger when a fire that isn't under control, or a fire perimeter, is this close to a zone.",
          "warning_distance": "Fire threat is Warning when any active fire, perimeter or satellite hotspot is this close. Must be at least the danger distance.",
          "smoke_radius": "How far away a fire can be and still count as a smoke source for Fire upwind and Wildfire smoke.",
          "air_quality_scale": "The scale Smoke impact uses. Automatic picks Canada's AQHI when Home Assistant's country is Canada, and the US AQI otherwise.",
          "wind_entity": "A sensor reporting the direction the wind is coming FROM, in degrees. Enables Fire upwind.",
          "pm25_entity": "An air-quality PM2.5 sensor (e.g. AirNow or PurpleAir). Enables Wildfire smoke.",
          "pm25_threshold": "PM2.5 at or above this counts as smoky. 35 µg/m³ is the US EPA 24-hour standard.",
          "provinces": "Adds Active fires and Area burned sensors for each agency picked. Every agency is always listed in the national sensors' attributes.",
          "map_fires": "Which fires get a map marker (geo_location.cwfis_* entity).",
          "map_images": "Canada-wide maps rendered by CWFIS, one image entity each. Works alongside the markers; show them with a Picture entity card."
        }
      }
    },
    "error": {
      "warning_inside_danger": "The warning distance must be at least the danger distance."
    }
  },
